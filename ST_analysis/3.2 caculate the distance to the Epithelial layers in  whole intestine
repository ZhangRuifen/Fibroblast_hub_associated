### 6. 对每个 spot 并行,筛选最适合的基准点！：现算距离 + 角度筛选（不生成全局 dists 矩阵）------------------------------------------------
spots.list <- pbmclapply(
  seq_len(nrow(set1_mat)),     # 每个 i 是一个 spot index (要迭代的向量/列表)
  
  # 要应用的函数
  function(i) {         
    P <- set1_mat[i, ]         # 每次取一个 spot 坐标 (px, py)
    
    # 6.1 计算该 spot 到所有Epithelial layers 像素点的距离向量 (长度 = n_base)
    # 直接用矩阵运算：每行是 set2_mat 的一个点
    dx <- set2_mat[, 1] - P[1]  # colnames(set2_mat): "col" "row"
    dy <- set2_mat[, 2] - P[2]
    d_vec <- sqrt(dx*dx + dy*dy) # 依次计算不同Epithelial layers 像素点的距离
    
    # 初筛：只保留 800 像素以内的基准点 (默认800像素点范围内的都是属于同一层的)
    idx <- which(d_vec < 3000)
    if (length(idx) == 0) return(NULL)
    dists.subset <- d_vec[idx]
    names(dists.subset) <- idx   # 得到了一个特定的spot点P与所有上皮层的像素距离
    
    # 6.2 角度方向筛选: 判断 spot 是否落在某条 epithelial layer 的内侧
    checks <- vapply(names(dists.subset), function(b) {
      b <- as.integer(b)
      
      xs_idx <- expand.range(
        xy.all[b, "ord"] %>% as.numeric(),
        exp.factor = 10,
        maxval    = nrow(xy.all)
      )
      xs <- xy.all[xs_idx, ]  # 基准线局部两个点
      
      # 极端情况下 xs[1,] 和 xs[2,] 可能是同一个点，先排除掉
      if (nrow(xs) < 2 ||
          (xs[1, "col"] == xs[2, "col"] && xs[1, "row"] == xs[2, "row"])) {
        return(FALSE)
      }
      
      # xs[1,], xs[2,]：基准层局部的两个像素点，形成一个局部切线；P：当前 spot；
      # 调整线段方向；统一方向，为了消除上下左右方向造成的符号混乱。
      ls <- adjust.coords(
        x = as.numeric(xs[1, c("col", "row")]),
        y = as.numeric(xs[2, c("col", "row")]),
        P = as.numeric(P)
      )
      x_loc <- ls[1:2]
      y_loc <- ls[3:4]
      
      ## === 新增：把图像坐标系转换为数学坐标系 ===
      x_math <- c(x_loc[1], -x_loc[2])          # x 不变，y 取负
      y_math <- c(y_loc[1], -y_loc[2])
      P_math <- c(P[1],      -P[2])
      
      # 在“数学坐标系”下计算角度
      ang <- sign_angle(x = x_math, y = y_math, P = P_math)
      
      
      # 正数：确保在spot点在上皮层内侧；
      # ang <- sign_angle(x = x_loc, y = y_loc, P = as.numeric(P))
      
      # 角度如果是 NA/NaN，直接视为不符合条件
      if (is.na(ang) || is.nan(ang)) {
        return(FALSE)
      }
      
      -45 > ang && ang > -135  # 45 < ang && ang < 135
    }, logical(1))
    
    if (!any(checks)) return(NULL)
    
    bl.subset <- dists.subset[checks]
    
    data.frame(
      dist = bl.subset,
      id   = as.integer(names(bl.subset)),  # 对应 xy.all$ord
      spot = i               # 对应 set1 第几行
    )
  },
  mc.cores = n_cores  # 并行核心数
)


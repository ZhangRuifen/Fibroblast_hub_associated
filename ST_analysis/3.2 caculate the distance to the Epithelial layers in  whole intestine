### 3. 定义一系列几何辅助函数（角度、朝向、局部线段）------------------------------------------------
# 1）调整坐标到相对于某个点 P 的局部坐标系
adjust.coords <- function(x, y, P){
  avg <- c(mean(c(x[1], y[1])), mean(c(x[2], y[2])))
  df  <- (P - avg)
  x_new <- x - df
  y_new <- y - df
  c(x_new, y_new)
}
# 2）叉积(二维向量)：判断点 P 相对于线段 x→y 的左右侧
sider <- function(x, y, P) {
  (P[1] - x[1])*(y[2] - x[2]) - (P[2] - x[2])*(y[1] - x[1])
}  
# 3）计算角度
angle <- function(x, y, P){
  Angle(A = P,
        B = c(mean(c(x[1], y[1])), mean(c(x[2], y[2]))),
        C = y)
}
# 4）带符号角度
sign_angle <- function(x, y, P) {
  angle(x, y, P) * sign(sider(x, y, P))  # sign取正负号
}
# 5）扩展索引范围
expand.range <- function(x, exp.factor = 5, maxval = 1e4) {
  c(max(1, x - exp.factor), min(x + exp.factor, maxval))
}


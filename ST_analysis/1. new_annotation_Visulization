# 分类
Fibroblast<-c("Tnc-Cd34+","Fibro_adipocyte","Fibro_contraction","Fibro_antigen_pre","Tnc+Cd34-","S1_COL6A5+")
Macrophage<-c("Macrophage1","Macrophage2")
DC<-c("DC", "pDC")
Neutrophil<-c( "Neutrophil")
Cyciling_cell<-c("Cyciling_cell")
B_cells<-c("NaïveB","Plasma")
T_cells<-c("Cd4T","Cd8T", "NK","gama_delta_T")
CC_1<-c( "pre_DCC", "DCC")
Mid_CC<-c("Mid_CC","M_cell")
CC_2<-c("pre_PCC", "PCC")

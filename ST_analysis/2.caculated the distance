dist_long$target_type <- NULL
other_df$target_id<-rownames(other_df)

dist_long <- dist_long %>%
  left_join(
    other_df %>% select(target_id, All.celltype),
    by = "target_id"
  ) %>%
  rename(target_type = All.celltype)


dist_long$sender<-'Fibroblast'
colnames(dist_long)

# ✅ 七、如果你只想要「平均距离」
mean_dist_by_type <- dist_long %>%
  group_by(Fibro_id, target_type) %>%
  summarise(
    mean_dist = mean(distance), 
    n_targets = n(),
    .groups = "drop")

#### 2.caculate distance between fibroblast and others ------------------------------------------------------------------------------------------------------------------------------
# ✅ 一、准备数据
# 只看Fibroblast, CC1,CC2,Macrophage细胞
colnames(subset_df)
df<-subset_df[subset_df$All.celltype %in% c("Fibroblast","Macrophage","CC_1","CC_2"),]
df<-df[,c(4,5,7)]

# ✅ 二、拆分 Fibroblast 与 非 Fibroblast
fibro_df <- df[df$All.celltype == "Fibroblast", ]
other_df <- df[df$All.celltype != "Fibroblast", ]

# ✅ 三、计算距离（核心）
# 提取坐标
fibro_xy <- as.matrix(fibro_df[, c("x", "y")])
other_xy <- as.matrix(other_df[, c("x", "y")])

# 计算距离矩阵（Fibroblast × Other）
# dist():计算所有点之间的欧几里得距离
# as.matrix(dist(...)):将距离对象转换为完整的n×n 对称矩阵；从而可以通过行列索引直接访问任意两点间的距离
dist_mat <- as.matrix(dist(rbind(fibro_xy, other_xy)))
dim(dist_mat)  # 227 227
# 取出 fibro -> other 的部分
n_fibro <- nrow(fibro_xy)
n_other <- nrow(other_xy)

fibro_to_other_dist <- dist_mat[1:n_fibro, (n_fibro + 1):(n_fibro + n_other)]

# ✅ 四、整理成长表（tidy 格式，推荐）
dist_df <- as.data.frame(fibro_to_other_dist)
# colnames(dist_df) <- paste0("cell_", seq_len(ncol(dist_df)))

# 距离矩阵的本质：行（Fibro_id）,列（target_id），单元格：他们的距离
dim(dist_df)  # 129  98

dist_long <- dist_df %>%
  mutate(Fibro_id = rownames(fibro_df)) %>%  # mutate():添加一个新列Fibro_id !!!(pivot_longer()不能操作“行名”，只能操作列名)
  pivot_longer(
    cols = -Fibro_id,  # 筛选除了Fibro_id之外的所有列
    names_to = "target_id",  # 将列名换为新列的数值
    values_to = "distance"   # 数值叫做distance
  )

dim(dist_long)  # 12642     3

# 加上 target 细胞类型
### 下面这个代码的错误！！！

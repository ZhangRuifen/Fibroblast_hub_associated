#### 1. 小提琴展示距离分布
# 1️⃣ 画距离分布 violin plot
p<-ggplot(dist_long, aes(x = target_type, y = distance, fill = target_type)) +
  geom_violin(scale = "width", trim = TRUE) +
  # 把每个点画出来：jitter（每个点一个位置偏移，避免重叠）
  geom_point(
    color = "grey",
    position = position_jitter(width = 0.15, height = 0),
    size = 0.6,
    alpha = 0.1
  ) +
  # ⭐ 平均值点
  stat_summary(
    fun = mean,
    geom = "point",
    shape = 23,        # 菱形
    size = 3,
    fill = "grey",
    color = "black"
  ) +
  scale_fill_manual(values = col_named) +
  #scale_color_manual(values = col_named) +
  theme_classic(base_size = 14) +
  theme(
    axis.text.x = element_text(angle = 45, hjust = 1),
    legend.position = "none"
  ) +
  labs(
    x = "Target cell type",
    y = "Distance to Fibroblast"
  )+
  # 显著性检验与标注（默认 Wilcoxon；你也可以改成 t.test）
  stat_compare_means(
    comparisons = comparision,
    method = "wilcox.test",
    label = "p.signif"
  )

#2️⃣ 如果你只想看“最近距离”分布(更有生物意义)

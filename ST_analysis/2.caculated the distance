#### 2. 最近邻细胞类型比例
# 1️⃣ 计算每个 Fibroblast 的最近邻(计算每个Fibro_id,在它所有的target细胞中条算出最近的那个)
nearest_neighbor <- dist_long %>%
  group_by(Fibro_id) %>%
  slice_min(order_by = distance,  # 按照距离从小到大
            n = 1,  # 只取每组中的最小距离(最近点)
            with_ties = FALSE  # 如果有多个距离相等的最近点，只去第一个
            )

# 2️⃣ 统计最近邻的细胞类型比例
nn_summary <- nearest_neighbor %>%
  count(target_type) %>%
  mutate(freq = n / sum(n))

# 3️⃣ 可视化（柱状图）
d<-ggplot(nn_summary, aes(x = target_type, y = freq, fill = target_type)) +
  geom_col() +
  theme_classic(base_size = 14) +
  theme(
    axis.text.x = element_text(angle = 45, hjust = 1),
    legend.position = "none"
  ) +
  scale_fill_manual(values = col) +
  labs(
    x = "Nearest neighbor cell type",
    y = "Proportion"
  )
pdf(file = 'distance.pdf',width = 3.5,height = 4)
p
b
d
